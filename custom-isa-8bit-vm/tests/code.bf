++++++++                Set Cell #0 to 8
[
    >++++               Add 4 to Cell #1
    [
        >++             Add 2 to Cell #2
        >+++            Add 3 to Cell #3
        >+++            Add 3 to Cell #4
        >+              Add 1 to Cell #5
        <<<<-           Decrement Cell #1
    ]
    >+                  Add 1 to Cell #2
    >+                  Add 1 to Cell #3
    >-                  Subtract 1 from Cell #4
    >>+                 Add 1 to Cell #6
    [<]                 Move back to Cell #1
    <-                  Decrement Cell #0
]
>>.                     Print Cell #2 ('H')
>---.                   Print Cell #3 ('e')
+++++++..+++.           Print Cell #3 ('llo')
>>.                     Print Cell #5 (' ')
<-.                     Print Cell #4 ('W')
<.                      Print Cell #3 ('o')
+++.------.--------.    Print Cell #3 ('rld')
>>+.                    Print Cell #5 ('!')
>++.                    Print Cell #6 ('\n')   
